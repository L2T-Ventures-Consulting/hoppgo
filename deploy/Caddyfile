# =============================================================================
# Hopp & Go — Reverse Proxy
# =============================================================================
# Caddy holt und erneuert die TLS-Zertifikate selbstständig bei Let's Encrypt.
#
# Die Domain kommt aus HOPPGO_DOMAIN in der .env. Solange die echten
# DNS-Einträge fehlen, kann dort ein sslip.io-Name stehen
# (z. B. 91-99-207-61.sslip.io) — der löst auf die Server-IP auf und bekommt
# ein vollwertiges Zertifikat. Umstellen auf hoppgo.de ist später ein einziger
# geänderter Wert, kein Umbau.
# =============================================================================

{
	email kontakt@hoppgo.de
}

{$HOPPGO_DOMAIN} {
	encode zstd gzip

	# Louez liefert eigene CSP-Header aus, deshalb hier bewusst keine —
	# sonst überschreiben wir die der Anwendung.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		# Analytics läuft in der Anwendung. Das Zugriffsprotokoll dient der
		# Fehlersuche, deshalb mit gekürzten IP-Adressen.
		format filter {
			wrap console
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
			}
		}
	}
}

# www leitet dauerhaft auf die Hauptdomain um, sobald sie gesetzt ist.
# Bei einem sslip.io-Namen greift dieser Block schlicht nie.
www.{$HOPPGO_DOMAIN} {
	redir https://{$HOPPGO_DOMAIN}{uri} permanent
}
