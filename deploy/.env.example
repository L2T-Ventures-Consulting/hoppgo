# =============================================================================
# Hopp & Go — Betriebskonfiguration
# =============================================================================
# Vorlage für die .env auf dem Server unter /opt/hoppgo/.env
# Die echte Datei liegt ausschließlich dort und niemals im Repository.
#
# Louez' vollständige Konfigurationsfläche steht in der /.env.example im
# Wurzelverzeichnis. Hier stehen nur die Werte, die wir tatsächlich setzen.
# =============================================================================

# --- Öffentliche Adresse ------------------------------------------------------
# Ohne abschließenden Schrägstrich. Beide Werte müssen identisch sein, sonst
# schlagen Anmeldung und Weiterleitungen nach dem Bezahlen fehl.
NEXT_PUBLIC_APP_URL="https://hoppgo.de"
AUTH_URL="https://hoppgo.de"
NEXT_PUBLIC_APP_DOMAIN="hoppgo.de"

# Standalone: eine Storefront direkt auf der Domain, Dashboard unter /dashboard.
# Nicht auf "platform" setzen — das ist der Mehrmandanten-Modus.
LOUEZ_MODE="standalone"

# --- Nur lokal erreichbar -----------------------------------------------------
# Caddy nimmt den Verkehr von außen an. Ohne die 127.0.0.1-Bindung stünde die
# Anwendung ungeschützt auf Port 3000 im Netz.
LOUEZ_PORT="127.0.0.1:3000"

# --- Zugangsdaten -------------------------------------------------------------
# Mit `openssl rand -base64 32` erzeugen. Nie wiederverwenden, nie teilen.
DB_PASSWORD="<mit openssl rand -base64 32 erzeugen>"
MINIO_ROOT_USER="hoppgo"
MINIO_ROOT_PASSWORD="<mit openssl rand -base64 32 erzeugen>"
AUTH_SECRET="<mit openssl rand -base64 32 erzeugen>"
CRON_SECRET="<mit openssl rand -base64 32 erzeugen>"

# --- E-Mail über Brevo --------------------------------------------------------
# Zugangsdaten stehen in Brevo unter SMTP & API. Der Benutzername ist nicht die
# Anmeldeadresse, sondern eine eigene Kennung der Form 9xxxxx@smtp-brevo.com.
# Das Passwort ist der SMTP-Schlüssel, nicht das Kontopasswort.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="<SMTP-Kennung aus Brevo>"
SMTP_PASSWORD="<SMTP-Schluessel aus Brevo>"
SMTP_FROM="Hopp & Go <buchung@hoppgo.de>"

# --- Stripe -------------------------------------------------------------------
# Der Webhook-Schlüssel entsteht erst beim Anlegen des Endpunkts in Stripe auf
# https://hoppgo.de/api/webhooks/stripe
STRIPE_SECRET_KEY="<sk_live_... aus Stripe>"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="<pk_live_... aus Stripe>"
STRIPE_WEBHOOK_SECRET="<whsec_... aus Stripe>"
